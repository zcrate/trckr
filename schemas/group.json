{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://trckr.dev/schemas/group.json",
  "title": "Group",
  "type": "object",
  "required": ["id", "label", "created_at"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^grp_[a-zA-Z0-9_-]+$",
      "description": "Unique group identifier."
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "User-defined name of the group (e.g., 'Work Stuff')."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
